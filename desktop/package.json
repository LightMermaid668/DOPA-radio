{
  "name": "dopa-radio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DOPA-radio desktop app (macOS / Windows)",
  "main": "main.js",
  "author": "DOPA-radio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "si.f5.sosukeiwasaki.dopa-radio",
    "productName": "DOPA-radio",
    "files": ["main.js", "preload.js"],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.music",
      "icon": "../public/icons/icon-512.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
