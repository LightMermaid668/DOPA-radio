# オリジンはCloudflare Tunnel経由（TLSはCloudflareのエッジで終端）
{
	auto_https off
}

# アプリ本体
http://{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# S3互換ストレージ（presigned URL の配信先。Range リクエスト対応）
# ブラウザからの presigned PUT 用に CORS を付与（署名検証はGarageが行う）
http://{$MEDIA_DOMAIN} {
	encode zstd gzip

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, PUT, HEAD, POST, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Access-Control-Max-Age "3600"
		respond 204
	}

	header Access-Control-Allow-Origin "*"
	header Access-Control-Expose-Headers "ETag"
	reverse_proxy garage:3900
}
