# ============================================================
# DOPA-radio 環境変数
# このファイルをコピーして .env を作成し、値を埋めてください
#   cp .env.example .env
# ============================================================

# --- ドメイン（Cloudflare Tunnel の Public Hostname と一致させる） ---
APP_DOMAIN=dopa-radio.sosukeiwasaki.f5.si
MEDIA_DOMAIN=dopa-media.sosukeiwasaki.f5.si

# --- 認証 (Better Auth) ---
# 生成コマンド: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dopa-radio.sosukeiwasaki.f5.si

# --- Google OAuth（Google Cloud Console で発行した値） ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify連携（任意。未設定ならSpotifyタブは案内表示になります） ---
# https://developer.spotify.com/dashboard でアプリを作成し、
# Redirect URI に https://dopa-radio.sosukeiwasaki.f5.si/api/integrations/spotify/callback を登録
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- 管理者（/admin で通報の確認・削除が可能） ---
# カンマ区切りで複数指定可。空の場合は初期メンバー(LightMermaid668@gmail.com)が管理者になります
ADMIN_EMAILS=

# --- PostgreSQL ---
POSTGRES_USER=dopa
POSTGRES_PASSWORD=
POSTGRES_DB=dopa
# 空の場合は POSTGRES_* から組み立てられます（compose 内では postgres が自動でホストになります）
# DATABASE_URL=postgres://dopa:password@postgres:5432/dopa

# --- S3互換ストレージ (Garage) ---
# 生成コマンド:
#   echo "S3_ACCESS_KEY=GK$(openssl rand -hex 16)"
#   echo "S3_SECRET_KEY=$(openssl rand -hex 32)"
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dopa-media
S3_REGION=garage
# コンテナ内部から使うエンドポイント
S3_ENDPOINT=http://garage:3900
# ブラウザ向け presigned URL のエンドポイント（MEDIA_DOMAIN と一致させる）
S3_PUBLIC_ENDPOINT=https://dopa-media.sosukeiwasaki.f5.si

# --- Cloudflare Tunnel ---
# Cloudflare Zero Trust → Networks → Tunnels で作成したトークン
CLOUDFLARE_TUNNEL_TOKEN=
